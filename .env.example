# ----- Database -----
# Local dev (Docker Postgres) or EC2 Postgres
DATABASE_URL="postgresql://botadmin:botpass@localhost:5432/botplatform?schema=public"

# ----- App -----
# Public base URL where Telegram will send webhooks.
# EC2 self-signed example: https://YOUR_EC2_IP:8443
# Domain example: https://bots.example.com
PUBLIC_BASE_URL="https://YOUR_EC2_PUBLIC_IP:8443"

# ----- Self-signed webhook (EC2 without a domain) -----
# Path to the PUBLIC certificate (.pem) Telegram should trust.
# Leave EMPTY/unset if you use a real domain + Let's Encrypt.
WEBHOOK_CERT_PATH="./certs/public.pem"

# 32-byte key (hex, 64 chars) used to encrypt bot tokens at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS"

# Secret used to derive per-bot webhook secret tokens.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET_SALT="REPLACE_WITH_RANDOM_STRING"

# ----- Admin dashboard login -----
ADMIN_USERNAME="admin"
# bcrypt hash of your password. Generate via: npm run db:seed (creates default) or hash manually.
ADMIN_PASSWORD="changeme"

# Session cookie signing secret
SESSION_SECRET="REPLACE_WITH_RANDOM_STRING"
